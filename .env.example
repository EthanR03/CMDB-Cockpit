# Copy to .env.local and fill in your own values. Server-side only — never commit real secrets.

DATABASE_URL=postgresql://localhost:5432/cmdb_cockpit
OPENAI_API_KEY=sk-...

# ServiceNow bridge — leave ENABLED=false to run the app without an instance.
SERVICENOW_ENABLED=false
SERVICENOW_INSTANCE_URL=https://devXXXXX.service-now.com
SERVICENOW_USER=
SERVICENOW_PASSWORD=
SERVICENOW_TEAM_IDENTIFIER=your_team_tag
SERVICENOW_STAGING_TABLE=x_your_scoped_staging_ci
SERVICENOW_TEAM_FIELD=u_team_tag
# Must be a registered choice on cmdb_ci.discovery_source
SERVICENOW_DATA_SOURCE=Manual via AI Agent
